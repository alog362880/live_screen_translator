# Copy to proxy/.env (git-ignored). Real environment variables override this file.
# Set a key for each provider you want to offer; unset providers return 404.
ANTHROPIC_API_KEY=sk-ant-your-real-key-here
# GEMINI_API_KEY=AIza-your-real-key-here
# OPENAI_API_KEY=sk-your-real-key-here
# Comma-separate to issue several. Each must be >= 24 chars: openssl rand -hex 24
PROXY_TOKENS=paste-a-proxy-token-here
# Only needed for Flutter Web (exact origins, comma-separated):
# ALLOWED_ORIGINS=https://your-web-app.example.com
# Per-provider model allowlists (defaults shown in proxy/lib/proxy.dart):
# ALLOWED_MODELS_CLAUDE=claude-sonnet-5
# ALLOWED_MODELS_GEMINI=gemini-2.5-flash,gemini-2.5-pro
# ALLOWED_MODELS_OPENAI=gpt-4o-mini,gpt-4o
# RATE_LIMIT_PER_MIN=20
# PORT=8080
